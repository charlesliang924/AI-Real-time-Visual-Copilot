# GEMINI_API_KEY: Required for Gemini AI API calls.
# IMPORTANT: Do NOT prefix with VITE_ - this must remain backend-only.
# The key is served only through the authenticated /api/config endpoint.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: 签发本地系统 Token 的秘钥 (必填，不设置将无法启动)
JWT_SECRET="your_very_secure_jwt_secret_here"
